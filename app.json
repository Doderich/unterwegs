{
  "expo": {
    "name": "Unterwegs",
    "slug": "unterwegs",
    "version": "1.6.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unterwegs",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./assets/locales/en.json",
      "de": "./assets/locales/de.json",
      "ja": "./assets/locales/ja.json"
    },
    "ios": {
      "icon": "./assets/unterwegs.icon",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./plugins/with-share-signing",
      "./plugins/with-release-signing",
      "./plugins/with-android-apks",
      "./plugins/with-map-downloads",
      "./plugins/with-user-certificates",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsFileWithMaxCount": 1,
              "supportsImageWithMaxCount": 5
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["application/pdf", "image/*", "text/plain"],
            "multipleShareMimeTypes": ["image/*"]
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Unterwegs uses the camera to scan the sign-in QR code and to take photos for your trip.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Unterwegs needs access to your photos to upload them to locations, lodging and transportation.",
          "cameraPermission": "Unterwegs uses the camera to scan the sign-in QR code and to take photos for your trip.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Unterwegs shows your location on the map and uses it when you add a place where you are.",
          "locationAlwaysAndWhenInUsePermission": "Unterwegs uses your location only while the app is open: on the map and when you add a place where you are.",
          "locationAlwaysPermission": "Unterwegs uses your location only while the app is open: on the map and when you add a place where you are.",
          "motionUsagePermission": "Unterwegs doesn't use motion data.",
          "locationFullAccuracyPermission": "Unterwegs uses your precise location to add a place exactly where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#2F7672"
        }
      ],
      "./plugins/with-widget-languages",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextWidget",
              "displayName": "Unterwegs",
              "description": "Your next collection and what's on today",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "configuration": {
                  "title": "Collection",
                  "description": "Which collection the widget shows",
                  "parameters": {
                    "collection": {
                      "title": "Collection",
                      "type": "enum",
                      "default": "auto",
                      "values": [
                        {
                          "name": "Automatic",
                          "value": "auto"
                        }
                      ],
                      "dynamic": true
                    }
                  }
                }
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110
              }
            },
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Today's plan",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"],
                "configuration": {
                  "title": "Collection",
                  "description": "Which collection the widget shows",
                  "parameters": {
                    "collection": {
                      "title": "Collection",
                      "type": "enum",
                      "default": "auto",
                      "values": [
                        {
                          "name": "Automatic",
                          "value": "auto"
                        }
                      ],
                      "dynamic": true
                    }
                  }
                }
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2
              }
            },
            {
              "name": "StayWidget",
              "displayName": "Accommodation",
              "description": "Where you sleep tonight",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110
              }
            },
            {
              "name": "DepartureWidget",
              "displayName": "Departure",
              "description": "Your next transport",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "accessoryRectangular"]
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
