# Copy to .env.local (gitignored) and fill in. Never commit personal values.

# iOS bundle id and Android package. Changing it makes a new app on the phone.
UNTERWEGS_APP_ID=com.example.unterwegs
# Apple Developer team id, for signed iOS builds.
UNTERWEGS_APPLE_TEAM_ID=
# iOS bundle id, when it differs from UNTERWEGS_APP_ID (an id stays with the Apple team that registered it first).
UNTERWEGS_IOS_BUNDLE_ID=
# Android upload key in 1Password, for npm run android:publish: where the keystore file is (or goes, with
# scripts/android-keystore.sh), its password field, and the certificate SHA-256 the script prints.
# File attachment, e.g. op://example-vault/Android signing/keystore (not the certificate fingerprint).
UNTERWEGS_KEYSTORE_OP_REF=
# Password field for that existing keystore, e.g. op://example-vault/Android signing/key.
UNTERWEGS_KEYSTORE_PASSWORD_OP_REF=
UNTERWEGS_UPLOAD_CERT_SHA256=
# Google Play service account JSON key in 1Password, for npm run android:bundle -- --upload, e.g.
# op://example-vault/Google Play upload/key.json (docs/RELEASING.md → Google Play).
UNTERWEGS_PLAY_SERVICE_ACCOUNT_OP_REF=
# Private GitHub repo (owner/name) that gets the APK releases; the APKs embed the personal URLs above.
UNTERWEGS_RELEASE_REPO=
# Server preset on the login screen (inlined into the JS bundle). Empty: the user types it.
EXPO_PUBLIC_DEFAULT_SERVER_URL=

# Over-the-air updates (xprem, docs/RELEASING.md). Empty: builds only run their embedded bundle.
# Server base URL (without /manifest) and the app's UUID from the xprem dashboard.
UNTERWEGS_UPDATES_URL=
UNTERWEGS_UPDATES_APP_ID=
# Explicit native-build channel. Staging scripts override this after loading .env.local.
UNTERWEGS_UPDATE_CHANNEL=production
# Publishing token: 1Password reference read with `op` (or set EOO_TOKEN in the shell). Quote it if it has spaces.
# OP_ACCOUNT picks the 1Password account when `op` is signed in to several (e.g. my.1password.eu).
EOO_TOKEN_OP_REF=
OP_ACCOUNT=
