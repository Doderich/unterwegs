  "scripts": {
    "start": "expo start --dev-client",
    "android": "DISABLE_CODE_SIGNING=1 expo run:android",
    "android:release": "env -u DISABLE_CODE_SIGNING sh -c 'expo prebuild --platform android && expo run:android --variant release \"$@\"' --",
    "android:publish": "./scripts/android-publish.sh",
    "android:bundle": "./scripts/android-bundle.sh",
    "ios": "DISABLE_CODE_SIGNING=1 expo run:ios",
    "ios:release": "env -u DISABLE_CODE_SIGNING sh -c 'expo prebuild --platform ios && expo run:ios --configuration Release \"$@\"' --",
    "ios:testflight": "./scripts/ios-testflight.sh",
    "native:clean": "expo prebuild --clean",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke-live.ts",
    "smoke:write": "tsx scripts/live-write-check.ts",
    "generate:api": "./scripts/generate-api-types.sh",
    "update:android": "./scripts/publish-update.sh --platform android",
    "update:ios": "./scripts/publish-update.sh --platform ios",
    "update:publish": "./scripts/publish-update.sh",
    "android:staging": "./scripts/staging-build.sh android",
    "ios:staging": "./scripts/staging-build.sh ios",
    "licenses": "node scripts/licenses.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
