+// Unterwegs patch: a string `url` prop on a Row or Column opens that deep link in this app when tapped, like a
+// SwiftUI `Link` inside an iOS widget.
+private fun ReadableMap.withUrlAction(modifier: GlanceModifier, context: Context): GlanceModifier {
+  val props = propsMap() ?: return modifier
+  if (!props.hasKey("url") || props.getType("url") != ReadableType.String) return modifier
+  val url = props.getString("url")
+  if (url.isNullOrEmpty()) return modifier
+  val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
+    .setPackage(context.packageName)
+    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+  return modifier.clickable(actionStartActivity(intent))
+}
